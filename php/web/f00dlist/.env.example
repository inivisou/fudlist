# .env.example — Variables de entorno para f00dlist
# Copiar a .env y rellenar con valores reales en el servidor

# ============================================================================
# BASE DE DATOS (MariaDB/MySQL)
# ============================================================================
DB_HOST=localhost
DB_NAME=inivi_f00dlist
DB_USER=inivi_tXU5o0w
# CRÍTICO: Cambiar a contraseña segura en producción
F00DLIST_DB_PASS=tu_contraseña_segura_aqui

# ============================================================================
# CONFIGURACIÓN DE LA APLICACIÓN
# ============================================================================
# Base path de la aplicación (default: /)
# Ej: /f00dlist/ si está en subdirectorio
F00DLIST_BASE_PATH=/

# Debug mode (false en producción)
F00DLIST_DEBUG=false
